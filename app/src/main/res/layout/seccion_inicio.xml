<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio: estado del motor, prueba rápida y accesos a lo más usado. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<TextView
			android:id="@+id/titulo_estado"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:accessibilityHeading="true"
			android:text="@string/estado"
			android:textAppearance="?attr/textAppearanceTitleLarge" />

		<TextView
			android:id="@+id/estado"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:accessibilityLiveRegion="polite"
			android:textAppearance="?attr/textAppearanceBodyLarge" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/motor_sistema"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:minHeight="48dp"
			android:text="@string/elegir_motor_sistema" />

		<TextView
			android:id="@+id/titulo_probar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:accessibilityHeading="true"
			android:text="@string/probar"
			android:textAppearance="?attr/textAppearanceTitleLarge" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/voz_prueba"
			style="@style/Widget.Material3.Button.OutlinedButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:minHeight="48dp" />

		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/contenedor_prueba"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:hint="@string/texto_prueba">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/texto_prueba"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="textMultiLine|textCapSentences"
				android:minHeight="56dp" />
		</com.google.android.material.textfield.TextInputLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/hablar"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginEnd="8dp"
				android:layout_weight="1"
				android:minHeight="48dp"
				android:text="@string/escuchar" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/detener"
				style="@style/Widget.Material3.Button.TonalButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:minHeight="48dp"
				android:text="@string/detener" />
		</LinearLayout>

		<TextView
			android:id="@+id/titulo_accesos"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:accessibilityHeading="true"
			android:text="@string/accesos"
			android:textAppearance="?attr/textAppearanceTitleLarge" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/ir_voces"
			style="@style/Widget.Material3.Button.TonalButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:minHeight="48dp"
			android:text="@string/descargar_mas_voces" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/ir_manual"
			style="@style/Widget.Material3.Button.TonalButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:text="@string/abrir_manual" />
	</LinearLayout>
</ScrollView>
