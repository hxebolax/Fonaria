	<!-- Settings: Sound -->
	<string name="cat_voz_general">Voice (for every voice)</string>
	<string name="velocidad">Speech rate</string>
	<string name="velocidad_resumen">Multiplied by the TalkBack or Android rate (see below how that one is used)</string>
	<string name="tono">Pitch</string>
	<string name="tono_resumen">Lower or higher</string>
	<string name="volumen">Volume</string>
	<string name="volumen_resumen">Over 100 percent may distort</string>
	<string name="ritmo">Natural pace</string>
	<string name="ritmo_resumen">Changed by the model itself: negative speaks lighter, positive more relaxed. Sounds more natural than the rate, but changes less</string>
	<string name="variacion">Intonation variation</string>
	<string name="variacion_resumen">0 is always the same and flat; higher is more expressive and varied</string>
	<string name="cat_sistema">System</string>
	<string name="velocidad_sistema">TalkBack and system speech rate</string>
	<string name="velocidad_sistema_resumen">The rate sent by TalkBack or the app that speaks</string>
	<string name="acelerar_modelo">Speed up with the model itself</string>
	<string name="acelerar_modelo_resumen">At high rates the voice itself speaks faster and Sonic stretches less: more natural, quicker, and no stutter on slow phones</string>
	<string name="tono_sistema">Use the system pitch</string>
	<string name="tono_sistema_resumen">The pitch sent by TalkBack or the app that speaks</string>
	<string name="cat_entonacion">Intonation and quality</string>
	<string name="semilla_fija">The same sentence always sounds the same</string>
	<string name="semilla_fija_resumen">Off, every reading is a different take, like a person</string>
	<string name="igualar_volumen">Level the volume</string>
	<string name="igualar_volumen_resumen">Compresses the audio so every voice and sentence sounds about as loud</string>
	<string name="guia">Voice fidelity</string>
	<string name="guia_resumen">Higher sounds closer to the original voice but takes twice as long. Off is the fastest</string>
	<string name="cat_pausas">Pauses and silence</string>
	<string name="recortar_silencios">Trim silence</string>
	<string name="recortar_silencios_resumen">Removes silence at the start and end of each sentence (responds sooner) and shortens overly long pauses in long texts</string>
	<string name="pausa_frases">Pause between sentences</string>
	<string name="pausa_frases_resumen">Silence between one sentence and the next</string>
	<string name="pausa_parrafos">Pause between paragraphs</string>
	<string name="pausa_parrafos_resumen">Silence at every line break</string>

