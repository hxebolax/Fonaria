	<string name="modelo_descargado">Model downloaded and selected</string>
	<string name="medir_motor">Measure engine speed</string>
	<string name="medir_motor_resumen">How much audio your phone generates per second with the current settings</string>
	<string name="midiendo">Measuring…</string>
	<string name="resultado_medida">Generates %1$.1f seconds of speech per second of computing (over 1 is faster than real time).\nFirst sound: %2$d milliseconds.\nModel load: %3$d milliseconds.\n\nTo avoid choppy speech, the final rate (yours times the TalkBack rate) should not exceed about %1$.1f times normal on this phone. Above that, Fonaria buffers a little audio before it starts speaking.\n\n%4$s</string>
	<string name="cat_avanzado">Advanced</string>
	<string name="hilos">Computing threads</string>
	<string name="hilos_resumen">Processor cores the engine uses. Automatic uses 4, the fastest on almost every phone. Applied after restarting the phone or force-stopping Fonaria</string>
	<string name="pasos">Decoding steps</string>
	<string name="pasos_resumen">More steps, a bit more quality and slower. 1 is recommended</string>
	<string name="umbral_fin">End of sentence</string>
	<string name="umbral_fin_resumen">Lower lets the voice go on longer before the sentence is considered finished. Raise it if endings drag on</string>
	<string name="tokens_trozo">Chunk size</string>
	<string name="tokens_trozo_resumen">How much text is generated at once. Automatic works almost always</string>
	<string name="adelanto">Audio buffered ahead</string>
	<string name="adelanto_resumen">How much speech may be generated ahead of what is playing. More avoids tiny gaps in long texts; stopping is still immediate, because pending audio is discarded</string>
	<string name="mimi_q8">Accelerated decoder (experimental)</string>
	<string name="mimi_q8_resumen">Faster on some processors, with slightly less quality</string>
	<string name="automatico">Automatic</string>
	<string name="del_modelo">The model\'s own</string>
	<string name="desactivada">Off</string>
