<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad y paso a otro móvil (Android 12+): igual que copia_seguridad.xml. -->
<data-extraction-rules>
	<cloud-backup>
		<include domain="device_sharedpref" path="ajustes.xml" />
		<include domain="device_file" path="fonaria/diccionario.json" />
		<include domain="device_file" path="fonaria/importadas/" />
	</cloud-backup>
	<device-transfer>
		<include domain="device_sharedpref" path="ajustes.xml" />
		<include domain="device_file" path="fonaria/diccionario.json" />
		<include domain="device_file" path="fonaria/importadas/" />
	</device-transfer>
</data-extraction-rules>
