<?xml version="1.0" encoding="utf-8"?>
<!-- Ajustes, pestaña Texto: cómo se prepara lo que se lee. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">

	<PreferenceCategory app:title="@string/cat_lectura" app:iconSpaceReserved="false">
		<SwitchPreferenceCompat app:key="normalizar" app:title="@string/normalizar" app:summary="@string/normalizar_resumen" android:defaultValue="true" app:iconSpaceReserved="false" />
		<ListPreference app:key="puntuacion" app:title="@string/puntuacion" app:entries="@array/puntuacion_nombres" app:entryValues="@array/puntuacion_valores" android:defaultValue="ninguna" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
		<SwitchPreferenceCompat app:key="emojis" app:title="@string/emojis" app:summary="@string/emojis_resumen" android:defaultValue="true" app:iconSpaceReserved="false" />
		<SwitchPreferenceCompat app:key="diccionarios" app:title="@string/usar_diccionario" app:summary="@string/usar_diccionario_resumen" android:defaultValue="true" app:iconSpaceReserved="false" />
	</PreferenceCategory>

	<PreferenceCategory app:title="@string/cat_deletreo" app:iconSpaceReserved="false">
		<SwitchPreferenceCompat app:key="deletrear" app:title="@string/deletrear" app:summary="@string/deletrear_resumen" android:defaultValue="true" app:iconSpaceReserved="false" />
		<com.xebolax.fonaria.accesibilidad.DeslizadorAjuste app:key="tono_mayusculas" app:title="@string/tono_mayusculas" app:summary="@string/tono_mayusculas_resumen" app:min="0" android:max="50" app:seekBarIncrement="5" app:showSeekBarValue="true" android:defaultValue="20" app:iconSpaceReserved="false" />
	</PreferenceCategory>

	<PreferenceCategory app:title="@string/cat_respuesta" app:iconSpaceReserved="false">
		<SwitchPreferenceCompat app:key="dividir_frases" app:title="@string/dividir_frases" app:summary="@string/dividir_frases_resumen" android:defaultValue="true" app:iconSpaceReserved="false" />
		<SwitchPreferenceCompat app:key="respuesta_rapida" app:title="@string/respuesta_rapida" app:summary="@string/respuesta_rapida_resumen" android:defaultValue="false" app:iconSpaceReserved="false" />
	</PreferenceCategory>
</PreferenceScreen>
